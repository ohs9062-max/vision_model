# AGX 경로·사용자·Python을 현장 환경에 맞게 수정한 후 사용한다. 자동 설치하지 않는다.
[Unit]
Description=Vision camera runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jetson
WorkingDirectory=/opt/vision_model
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/vision_model/.venv/bin/python -m vision_model.runtime --config /opt/vision_model/config/runtime.yaml
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
